{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "crm",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_compat"],

	// run_worker_first e obrigatorio: sem ele o roteador de assets responde
	// /api/* com index.html e a API deixa de existir.
	"assets": {
		"directory": "./web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "crm",
			"database_id": "PREENCHA_COM_O_ID_DO_D1",
			"migrations_dir": "migrations"
		}
	],

	"kv_namespaces": [{ "binding": "CACHE", "id": "PREENCHA_COM_O_ID_DO_KV" }],

	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "crm-media" }],

	"triggers": { "crons": ["0 5 * * *"] },

	"observability": { "enabled": true },

	"vars": {
		"ALLOWED_SIGN_IN": "",
		"REPORTING_CURRENCY": "BRL"
	}
}
