{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["@cloudflare/workers-types", "vite/client"],
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"baseUrl": ".",
		"paths": {
			"~/prisma/*": ["./node_modules/.prisma-d1/*"],
			"~/shared/*": ["./shared/*"],
			"~/worker/*": ["./worker/*"],
			"~/web/*": ["./web/src/*"]
		}
	},
	"include": ["worker", "web", "shared", "scripts", "test"],
	"exclude": ["worker/generated"]
}
