{
	"name": "@crm/cloudflare",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently -n web,worker -c cyan,magenta \"vite --config web/vite.config.ts\" \"wrangler dev\"",
		"build": "vite build --config web/vite.config.ts",
		"deploy": "bun run build && wrangler deploy",
		"check-types": "tsc --noEmit",
		"db:generate": "prisma generate --schema prisma/schema.prisma",
		"db:diff": "bun scripts/diff.ts",
		"db:apply": "wrangler d1 migrations apply crm --local",
		"db:apply:remote": "wrangler d1 migrations apply crm --remote",
		"db:studio": "prisma studio --schema prisma/schema.prisma",
		"test": "vitest run",
		"lint": "biome check .",
		"test:unit": "vitest run test/search-key.test.ts test/money.test.ts",
		"test:smoke": "bash scripts/smoke.sh"
	},
	"dependencies": {
		"@crm/ui": "workspace:*",
		"@hono/trpc-server": "^0.4.2",
		"@prisma/adapter-d1": "^7.10.0",
		"@prisma/client": "^7.9.1",
		"@tanstack/react-query": "^5.101.2",
		"@trpc/client": "^11.18.0",
		"@trpc/server": "^11.18.0",
		"@trpc/tanstack-react-query": "^11.18.0",
		"better-auth": "^1.6.25",
		"hono": "^4.13.8",
		"kysely": "^0.29.5",
		"kysely-d1": "^0.4.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-router": "^8.4.0",
		"sonner": "^2.0.7",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@cloudflare/workers-types": "^5.20260915.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.1.1",
		"concurrently": "^9.1.0",
		"prisma": "^7.9.1",
		"tailwindcss": "^4",
		"typescript": "5.9.2",
		"vite": "^8.3.0",
		"vitest": "^4.1.0",
		"wrangler": "^4.132.0"
	}
}
